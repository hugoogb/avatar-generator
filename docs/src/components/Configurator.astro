---
/**
 * Interactive single-style configurator: pick a style, adjust its options via
 * form controls, see the avatar the real package draws, and copy the exact
 * createAvatar() call for the current configuration.
 */
import { STYLES } from "../lib/styles";
---

<div class="cfg not-content">
    <div class="cfg-controls">
        <div class="cfg-row">
            <label>Style
                <select id="cfg-style">
                    {STYLES.map(({ name, label }) => <option value={name}>{label}</option>)}
                </select>
            </label>

            <label>Seed
                <input id="cfg-seed" type="text" value="Hugo GB"/>
            </label>

            <label>Size
                <input id="cfg-size" type="range" min="32" max="200" value="96"/>
                <span id="cfg-size-value">96</span>
            </label>
        </div>

        <div class="cfg-row cfg-base-options">
            <label><input id="cfg-square" type="checkbox"/> Square</label>
            <label><input id="cfg-transparent" type="checkbox"/> Transparent</label>
        </div>

        <div class="cfg-row cfg-style-options" id="cfg-style-options"></div>
    </div>

    <div class="cfg-preview">
        <div id="cfg-preview"></div>
        <pre class="cfg-code"><code id="cfg-code"></code></pre>
    </div>
</div>

<style>
    .cfg {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 1.5rem;
        margin: 1.5rem 0;
        background: var(--sl-color-gray-6);
        padding: 1.25rem;
        border-radius: 0.5rem;
    }
    @media (max-width: 720px) { .cfg { grid-template-columns: 1fr; } }
    .cfg-row { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.75rem; }
    .cfg-row label { display: flex; flex-direction: column; font-size: 0.85rem; gap: 0.3rem; }
    .cfg-base-options label { flex-direction: row; align-items: center; gap: 0.4rem; }
    .cfg select, .cfg input[type="text"] {
        padding: 0.35rem 0.55rem;
        border-radius: 0.25rem;
        border: 1px solid var(--sl-color-gray-4);
        background: var(--sl-color-gray-7);
        color: var(--sl-color-text);
        font-size: 0.85rem;
    }
    .cfg input[type="range"] { width: 120px; }
    .cfg-preview { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
    .cfg-code {
        width: 100%;
        font-size: 0.72rem;
        padding: 0.6rem;
        background: var(--sl-color-gray-7);
        border-radius: 0.35rem;
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
    }
    /* The style options are created by the script, so scoped rules do not reach them. */
    .cfg-style-options :global(label) { display: flex; flex-direction: column; font-size: 0.85rem; gap: 0.3rem; }
    .cfg-style-options :global(select) {
        padding: 0.35rem 0.55rem;
        border-radius: 0.25rem;
        border: 1px solid var(--sl-color-gray-4);
        background: var(--sl-color-gray-7);
        color: var(--sl-color-text);
        font-size: 0.85rem;
    }
    #cfg-size-value { min-width: 30px; font-size: 0.8rem; color: var(--sl-color-gray-2); }
</style>

<script>
    import { createAvatar, type AvatarOptions } from "@avatar-generator/core";
    import { STYLES, type Choice } from "../lib/styles";

    const styleSel = document.getElementById("cfg-style") as HTMLSelectElement;
    const seedInput = document.getElementById("cfg-seed") as HTMLInputElement;
    const sizeInput = document.getElementById("cfg-size") as HTMLInputElement;
    const sizeValue = document.getElementById("cfg-size-value")!;
    const squareInput = document.getElementById("cfg-square") as HTMLInputElement;
    const transparentInput = document.getElementById("cfg-transparent") as HTMLInputElement;
    const styleOptionsRow = document.getElementById("cfg-style-options")!;
    const preview = document.getElementById("cfg-preview")!;
    const codeOutput = document.getElementById("cfg-code")!;

    const current = () => STYLES.find((entry) => entry.name === styleSel.value) ?? STYLES[0];

    /** One select per option; its values index into the option's choices, so numbers and booleans survive. */
    function renderStyleOptions() {
        styleOptionsRow.replaceChildren();
        for (const [key, values] of Object.entries(current().choices)) {
            const label = document.createElement("label");
            label.textContent = key;
            const select = document.createElement("select");
            select.dataset.optKey = key;
            select.add(new Option("(from seed)", ""));
            values.forEach((value, index) => select.add(new Option(String(value), String(index))));
            select.addEventListener("change", update);
            label.appendChild(select);
            styleOptionsRow.appendChild(label);
        }
    }

    function collectStyleOptions(): Record<string, Choice> {
        const { choices } = current();
        const options: Record<string, Choice> = {};
        for (const select of styleOptionsRow.querySelectorAll<HTMLSelectElement>("select[data-opt-key]")) {
            const key = select.dataset.optKey!;
            if (select.value !== "") options[key] = choices[key][Number(select.value)];
        }
        return options;
    }

    function update() {
        const { name, label, style } = current();
        const size = Number(sizeInput.value);
        sizeValue.textContent = String(size);

        const options = {
            seed: seedInput.value,
            size,
            ...(squareInput.checked && { square: true }),
            ...(transparentInput.checked && { transparent: true }),
            ...collectStyleOptions(),
        } as AvatarOptions;

        const img = document.createElement("img");
        img.src = createAvatar(style, options).toDataUri();
        img.width = size;
        img.height = size;
        img.alt = `${label} avatar for “${options.seed}”`;
        preview.replaceChildren(img);

        const formatted = JSON.stringify(options, null, 4);
        codeOutput.textContent =
            `import { createAvatar } from "@avatar-generator/core";\n` +
            `import { ${name} } from "@avatar-generator/style-${name}";\n\n` +
            `const avatar = createAvatar(${name}, ${formatted});`;
    }

    styleSel.addEventListener("change", () => {
        renderStyleOptions();
        update();
    });
    [seedInput, sizeInput, squareInput, transparentInput].forEach((el) => el.addEventListener("input", update));
    renderStyleOptions();
    update();
</script>
