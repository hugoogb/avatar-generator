---
/**
 * Visual gallery of every avatar style, rendered from a fixed seed set so
 * readers can compare styles side by side.
 */
---

<div class="gallery">
    <p class="gallery-intro">
        Every style rendered from the same four seeds so you can compare them directly.
    </p>

    <div class="gallery-grid">
        <section class="gallery-style" data-style="initials">
            <h3>Initials</h3>
            <code>@avatar-generator/style-initials</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="geometric">
            <h3>Geometric</h3>
            <code>@avatar-generator/style-geometric</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="pixels">
            <h3>Pixels</h3>
            <code>@avatar-generator/style-pixels</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="rings">
            <h3>Rings</h3>
            <code>@avatar-generator/style-rings</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="faces">
            <h3>Faces</h3>
            <code>@avatar-generator/style-faces</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="illustrated">
            <h3>Illustrated</h3>
            <code>@avatar-generator/style-illustrated</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="anime">
            <h3>Anime</h3>
            <code>@avatar-generator/style-anime</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="abstract">
            <h3>Abstract</h3>
            <code>@avatar-generator/style-abstract</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="emoji">
            <h3>Emoji</h3>
            <code>@avatar-generator/style-emoji</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="animals">
            <h3>Animals</h3>
            <code>@avatar-generator/style-animals</code>
            <div class="row" data-seeds></div>
        </section>
        <section class="gallery-style" data-style="gradient">
            <h3>Gradient</h3>
            <code>@avatar-generator/style-gradient</code>
            <div class="row" data-seeds></div>
        </section>
    </div>
</div>

<style>
    .gallery { margin: 1.5rem 0; }
    .gallery-intro { color: var(--sl-color-gray-2); font-size: 0.9rem; margin-bottom: 1rem; }
    .gallery-grid { display: grid; gap: 1.25rem; }
    .gallery-style { background: var(--sl-color-gray-7); border-radius: 0.5rem; padding: 1rem 1.25rem; }
    .gallery-style h3 { margin: 0 0 0.15rem 0; font-size: 1rem; }
    .gallery-style code { font-size: 0.72rem; color: var(--sl-color-gray-2); display: block; margin-bottom: 0.75rem; }
    .row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .row img { width: 72px; height: 72px; border-radius: 50%; }
</style>

<script>
    const SEEDS = ["Hugo GB", "alice@example.com", "user-42", "team-design"];

    const DEFAULT_COLORS = ["#FF6B6B","#4ECDC4","#45B7D1","#96CEB4","#FFEAA7","#DDA0DD","#98D8C8","#F7DC6F"];
    const SKIN_TONES = ["#FFDBB4","#EAC086","#C68B59","#A0674B","#8D5524"];

    function hashSeed(seed: string): number {
        let h1 = 0xdeadbeef;
        let h2 = 0x41c6ce57;
        for (let i = 0; i < seed.length; i++) {
            const ch = seed.charCodeAt(i);
            h1 = Math.imul(h1 ^ ch, 2654435761);
            h2 = Math.imul(h2 ^ ch, 1597334677);
        }
        h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507);
        h1 ^= Math.imul(h2 ^ (h2 >>> 13), 3266489909);
        return h1 >>> 0;
    }
    function rng(seed: string) {
        let s = hashSeed(seed);
        const next = () => {
            let t = (s += 0x6d2b79f5);
            t = Math.imul(t ^ (t >>> 15), t | 1);
            t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
        return { next, pick: <T,>(arr: readonly T[]): T => arr[Math.floor(next() * arr.length)], bool: (p = 0.5) => next() < p };
    }

    const SIZE = 64;
    const svgOpen = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${SIZE} ${SIZE}" width="${SIZE}" height="${SIZE}">`;
    type GenFn = (seed: string) => string;

    const genInitials: GenFn = (seed) => {
        const r = rng(seed);
        const bg = r.pick(DEFAULT_COLORS);
        const letters = seed.split(" ").filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join("") || "?";
        return `${svgOpen}<rect width="${SIZE}" height="${SIZE}" fill="${bg}"/><text x="${SIZE/2}" y="${SIZE/2}" font-family="sans-serif" font-size="${SIZE * (letters.length === 1 ? 0.5 : 0.4)}" font-weight="600" fill="#fff" text-anchor="middle" dominant-baseline="central">${letters}</text></svg>`;
    };

    const genGeometric: GenFn = (seed) => {
        const r = rng(seed);
        const bg = r.pick(DEFAULT_COLORS);
        const fg = r.pick(DEFAULT_COLORS.filter(c => c !== bg));
        const grid = 5;
        const cell = SIZE / (grid + 2);
        let tiles = "";
        for (let row = 0; row < grid; row++) {
            for (let col = 0; col < Math.ceil(grid / 2); col++) {
                if (r.bool(0.5)) {
                    const x1 = (1 + col) * cell;
                    const x2 = (1 + (grid - 1 - col)) * cell;
                    const y = (1 + row) * cell;
                    tiles += `<rect x="${x1}" y="${y}" width="${cell}" height="${cell}" fill="${fg}"/>`;
                    if (col !== grid - 1 - col) tiles += `<rect x="${x2}" y="${y}" width="${cell}" height="${cell}" fill="${fg}"/>`;
                }
            }
        }
        return `${svgOpen}<rect width="${SIZE}" height="${SIZE}" fill="${bg}"/>${tiles}</svg>`;
    };

    const genRings: GenFn = (seed) => {
        const r = rng(seed);
        const bg = r.pick(DEFAULT_COLORS);
        const cx = SIZE / 2, cy = SIZE / 2;
        let body = "";
        for (let i = 3; i >= 0; i--) {
            body += `<circle cx="${cx}" cy="${cy}" r="${((i + 1) / 4) * (SIZE / 2)}" fill="${r.pick(DEFAULT_COLORS)}"/>`;
        }
        return `${svgOpen}<rect width="${SIZE}" height="${SIZE}" fill="${bg}"/>${body}</svg>`;
    };

    const genPixels: GenFn = (seed) => {
        const r = rng(seed);
        const bg = r.pick(DEFAULT_COLORS);
        const skin = r.pick(SKIN_TONES);
        const cell = SIZE / 8;
        let body = "";
        for (let row = 1; row <= 6; row++) {
            for (let col = 1; col <= 6; col++) {
                if ((row === 1 || row === 6) && (col === 1 || col === 6)) continue;
                body += `<rect x="${col * cell}" y="${row * cell}" width="${cell}" height="${cell}" fill="${skin}"/>`;
            }
        }
        body += `<rect x="${2*cell}" y="${3*cell}" width="${cell}" height="${cell}" fill="#2C1810"/><rect x="${5*cell}" y="${3*cell}" width="${cell}" height="${cell}" fill="#2C1810"/><rect x="${3*cell}" y="${5*cell}" width="${cell*2}" height="${cell}" fill="#2C1810"/>`;
        return `${svgOpen}<rect width="${SIZE}" height="${SIZE}" fill="${bg}"/>${body}</svg>`;
    };

    const genFaces: GenFn = (seed) => {
        const r = rng(seed);
        const bg = r.pick(DEFAULT_COLORS);
        const skin = r.pick(SKIN_TONES);
        const hair = r.pick(DEFAULT_COLORS);
        const cx = SIZE / 2, cy = SIZE / 2;
        const hw = SIZE * 0.3, hh = SIZE * 0.3;
        return `${svgOpen}<rect width="${SIZE}" height="${SIZE}" fill="${bg}"/><ellipse cx="${cx}" cy="${cy - hh*0.5}" rx="${hw*1.1}" ry="${hh*0.4}" fill="${hair}"/><ellipse cx="${cx}" cy="${cy}" rx="${hw}" ry="${hh}" fill="${skin}"/><circle cx="${cx - hw*0.35}" cy="${cy - hh*0.1}" r="2" fill="#2C1810"/><circle cx="${cx + hw*0.35}" cy="${cy - hh*0.1}" r="2" fill="#2C1810"/><path d="M ${cx-5} ${cy + hh*0.3} Q ${cx} ${cy + hh*0.5} ${cx+5} ${cy + hh*0.3}" fill="none" stroke="#2C1810" stroke-width="1.5"/></svg>`;
    };

    const genIllustrated: GenFn = (seed) => genFaces(seed + "-illust");

    const genAnime: GenFn = (seed) => {
        const r = rng(seed);
        const bg = r.pick(DEFAULT_COLORS);
        const skin = r.pick(SKIN_TONES);
        const hair = r.pick(["#1a1a2e","#c23616","#0984e3","#6c5ce7","#fd79a8"]);
        const cx = SIZE / 2, cy = SIZE / 2;
        const hw = SIZE * 0.29;
        return `${svgOpen}<rect width="${SIZE}" height="${SIZE}" fill="${bg}"/><ellipse cx="${cx}" cy="${cy - hw*0.7}" rx="${hw*1.2}" ry="${hw*0.5}" fill="${hair}"/><ellipse cx="${cx}" cy="${cy}" rx="${hw}" ry="${hw*1.1}" fill="${skin}"/><ellipse cx="${cx-8}" cy="${cy}" rx="4" ry="5" fill="#fff"/><ellipse cx="${cx-8}" cy="${cy+1}" rx="2.5" ry="3.5" fill="#6c5ce7"/><ellipse cx="${cx+8}" cy="${cy}" rx="4" ry="5" fill="#fff"/><ellipse cx="${cx+8}" cy="${cy+1}" rx="2.5" ry="3.5" fill="#6c5ce7"/></svg>`;
    };

    const genAbstract: GenFn = (seed) => {
        const r = rng(seed);
        const comp = r.pick(["mondrian","kandinsky","bauhaus"] as const);
        const colors = ["#D40000","#FFDE00","#0051BA","#FFFFFF"];
        const bold = ["#E63946","#F1C40F","#2A9D8F","#264653","#F4A261"];
        if (comp === "mondrian") {
            const vx = Math.floor(SIZE * 0.45);
            const hy = Math.floor(SIZE * 0.5);
            return `${svgOpen}<rect x="0" y="0" width="${vx}" height="${hy}" fill="${r.pick(colors)}"/><rect x="${vx}" y="0" width="${SIZE-vx}" height="${hy}" fill="${r.pick(colors)}"/><rect x="0" y="${hy}" width="${vx}" height="${SIZE-hy}" fill="${r.pick(colors)}"/><rect x="${vx}" y="${hy}" width="${SIZE-vx}" height="${SIZE-hy}" fill="${r.pick(colors)}"/><rect x="${vx-1.5}" y="0" width="3" height="${SIZE}" fill="#111"/><rect x="0" y="${hy-1.5}" width="${SIZE}" height="3" fill="#111"/></svg>`;
        }
        if (comp === "kandinsky") {
            return `${svgOpen}<rect width="${SIZE}" height="${SIZE}" fill="${r.pick(bold)}"/><circle cx="${SIZE/2}" cy="${SIZE/2}" r="${SIZE*0.25}" fill="${r.pick(bold)}"/><circle cx="${SIZE/2}" cy="${SIZE/2}" r="${SIZE*0.12}" fill="${r.pick(bold)}"/><polygon points="16,16 24,8 32,20" fill="${r.pick(bold)}"/></svg>`;
        }
        return `${svgOpen}<rect x="0" y="0" width="${SIZE/2}" height="${SIZE/2}" fill="${r.pick(bold)}"/><rect x="${SIZE/2}" y="0" width="${SIZE/2}" height="${SIZE/2}" fill="${r.pick(bold)}"/><rect x="0" y="${SIZE/2}" width="${SIZE/2}" height="${SIZE/2}" fill="${r.pick(bold)}"/><rect x="${SIZE/2}" y="${SIZE/2}" width="${SIZE/2}" height="${SIZE/2}" fill="${r.pick(bold)}"/><circle cx="${SIZE*0.25}" cy="${SIZE*0.75}" r="${SIZE*0.15}" fill="${r.pick(bold)}"/></svg>`;
    };

    const genEmoji: GenFn = (seed) => {
        const r = rng(seed);
        const expr = r.pick(["happy","laughing","cool","wink","love","sad","sleepy"] as const);
        const bg = r.pick(["#FFF8E7","#FFEAA7"]);
        const face = "#FFD93D";
        const stroke = "#2C2C2C";
        const cx = SIZE/2, cy = SIZE/2, rR = SIZE*0.42;
        let body = `<rect width="${SIZE}" height="${SIZE}" fill="${bg}"/><circle cx="${cx}" cy="${cy}" r="${rR}" fill="${face}" stroke="${stroke}" stroke-width="1.5"/>`;
        const lx = cx - rR*0.35, rx = cx + rR*0.35, eyeY = cy - rR*0.18;
        if (expr === "laughing") body += `<path d="M ${lx-4} ${eyeY+1} Q ${lx} ${eyeY-4} ${lx+4} ${eyeY+1}" fill="none" stroke="${stroke}" stroke-width="2"/><path d="M ${rx-4} ${eyeY+1} Q ${rx} ${eyeY-4} ${rx+4} ${eyeY+1}" fill="none" stroke="${stroke}" stroke-width="2"/>`;
        else if (expr === "cool") body += `<rect x="${lx-5}" y="${eyeY-3}" width="10" height="6" fill="${stroke}"/><rect x="${rx-5}" y="${eyeY-3}" width="10" height="6" fill="${stroke}"/>`;
        else if (expr === "love") body += `<text x="${lx}" y="${eyeY+4}" font-size="10" fill="#E74C3C" text-anchor="middle">♥</text><text x="${rx}" y="${eyeY+4}" font-size="10" fill="#E74C3C" text-anchor="middle">♥</text>`;
        else if (expr === "sleepy") body += `<line x1="${lx-4}" y1="${eyeY}" x2="${lx+4}" y2="${eyeY}" stroke="${stroke}" stroke-width="2"/><line x1="${rx-4}" y1="${eyeY}" x2="${rx+4}" y2="${eyeY}" stroke="${stroke}" stroke-width="2"/>`;
        else body += `<circle cx="${lx}" cy="${eyeY}" r="3" fill="${stroke}"/><circle cx="${rx}" cy="${eyeY}" r="3" fill="${stroke}"/>`;
        const mY = cy + rR*0.3;
        if (expr === "sad") body += `<path d="M ${cx-6} ${mY+3} Q ${cx} ${mY-2} ${cx+6} ${mY+3}" fill="none" stroke="${stroke}" stroke-width="2"/>`;
        else body += `<path d="M ${cx-6} ${mY} Q ${cx} ${mY+4} ${cx+6} ${mY}" fill="none" stroke="${stroke}" stroke-width="2"/>`;
        return svgOpen + body + "</svg>";
    };

    const genAnimals: GenFn = (seed) => {
        const r = rng(seed);
        const bg = r.pick(DEFAULT_COLORS);
        const animal = r.pick(["cat","fox","panda","bunny","frog"] as const);
        const fur = r.pick(["#D4A574","#A67B5B","#E8C89C"]);
        const cx = SIZE/2, cy = SIZE/2, hw = SIZE*0.3, hh = SIZE*0.29;
        let body = `<rect width="${SIZE}" height="${SIZE}" fill="${bg}"/>`;
        if (animal === "panda") {
            body += `<circle cx="${cx-hw*0.85}" cy="${cy-hh*0.8}" r="${hw*0.25}" fill="#1A1A1A"/><circle cx="${cx+hw*0.85}" cy="${cy-hh*0.8}" r="${hw*0.25}" fill="#1A1A1A"/><ellipse cx="${cx}" cy="${cy}" rx="${hw}" ry="${hh}" fill="#fff"/><ellipse cx="${cx-hw*0.32}" cy="${cy-hh*0.05}" rx="${hw*0.2}" ry="${hh*0.22}" fill="#1A1A1A"/><ellipse cx="${cx+hw*0.32}" cy="${cy-hh*0.05}" rx="${hw*0.2}" ry="${hh*0.22}" fill="#1A1A1A"/>`;
        } else if (animal === "frog") {
            body += `<circle cx="${cx-hw*0.45}" cy="${cy-hh*0.55}" r="${hw*0.3}" fill="#6FB368"/><circle cx="${cx+hw*0.45}" cy="${cy-hh*0.55}" r="${hw*0.3}" fill="#6FB368"/><ellipse cx="${cx}" cy="${cy+hh*0.1}" rx="${hw*1.05}" ry="${hh*0.85}" fill="#6FB368"/><circle cx="${cx-hw*0.45}" cy="${cy-hh*0.5}" r="${hw*0.1}" fill="#1A1A1A"/><circle cx="${cx+hw*0.45}" cy="${cy-hh*0.5}" r="${hw*0.1}" fill="#1A1A1A"/>`;
        } else if (animal === "bunny") {
            body += `<ellipse cx="${cx-hw*0.35}" cy="${cy-hh*0.8}" rx="${hw*0.2}" ry="${hh*0.9}" fill="${fur}"/><ellipse cx="${cx+hw*0.35}" cy="${cy-hh*0.8}" rx="${hw*0.2}" ry="${hh*0.9}" fill="${fur}"/><ellipse cx="${cx}" cy="${cy}" rx="${hw}" ry="${hh*0.9}" fill="${fur}"/><circle cx="${cx-hw*0.28}" cy="${cy-hh*0.05}" r="2" fill="#2C1810"/><circle cx="${cx+hw*0.28}" cy="${cy-hh*0.05}" r="2" fill="#2C1810"/>`;
        } else {
            const color = animal === "fox" ? "#D96E2E" : fur;
            body += `<polygon points="${cx-hw+2},${cy-hh*0.4} ${cx-hw*0.5},${cy-hh-hw*0.3} ${cx-hw*0.2},${cy-hh*0.2}" fill="${color}"/><polygon points="${cx+hw-2},${cy-hh*0.4} ${cx+hw*0.5},${cy-hh-hw*0.3} ${cx+hw*0.2},${cy-hh*0.2}" fill="${color}"/><ellipse cx="${cx}" cy="${cy}" rx="${hw}" ry="${hh}" fill="${color}"/><circle cx="${cx-hw*0.35}" cy="${cy-hh*0.05}" r="2" fill="#2C1810"/><circle cx="${cx+hw*0.35}" cy="${cy-hh*0.05}" r="2" fill="#2C1810"/>`;
        }
        return svgOpen + body + "</svg>";
    };

    const genGradient: GenFn = (seed) => {
        const r = rng(seed);
        const palette = ["#FF6B9D","#C644FC","#5A17EE","#2196F3","#00BCD4","#00E676","#FFD600","#E91E63"];
        const direction = r.pick(["linear","radial","diagonal"] as const);
        const stops = [r.pick(palette), r.pick(palette)];
        const gid = `g-${seed.replace(/\W/g, "")}-${direction}`;
        let defs = "";
        if (direction === "linear") defs = `<linearGradient id="${gid}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${stops[0]}"/><stop offset="100%" stop-color="${stops[1]}"/></linearGradient>`;
        else if (direction === "diagonal") defs = `<linearGradient id="${gid}" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="${stops[0]}"/><stop offset="100%" stop-color="${stops[1]}"/></linearGradient>`;
        else defs = `<radialGradient id="${gid}" cx="50%" cy="50%" r="70%"><stop offset="0%" stop-color="${stops[0]}"/><stop offset="100%" stop-color="${stops[1]}"/></radialGradient>`;
        return `${svgOpen}<defs>${defs}</defs><rect width="${SIZE}" height="${SIZE}" fill="url(#${gid})"/></svg>`;
    };

    const RENDERERS: Record<string, GenFn> = {
        initials: genInitials, geometric: genGeometric, pixels: genPixels, rings: genRings,
        faces: genFaces, illustrated: genIllustrated, anime: genAnime,
        abstract: genAbstract, emoji: genEmoji, animals: genAnimals, gradient: genGradient,
    };

    document.querySelectorAll<HTMLElement>(".gallery-style").forEach((section) => {
        const style = section.dataset.style ?? "";
        const row = section.querySelector<HTMLElement>("[data-seeds]");
        const fn = RENDERERS[style];
        if (!row || !fn) return;
        row.replaceChildren();
        for (const seed of SEEDS) {
            const img = document.createElement("img");
            img.alt = style + " — " + seed;
            img.title = seed;
            img.src = "data:image/svg+xml;base64," + btoa(fn(seed));
            row.appendChild(img);
        }
    });
</script>
