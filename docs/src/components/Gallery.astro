---
/**
 * Visual gallery of every avatar style, rendered from a fixed seed set so
 * readers can compare styles side by side. Rendered at build time with the
 * real packages, so the page ships plain images and no script.
 */
import { createAvatar } from "@avatar-generator/core";
import { STYLES } from "../lib/styles";

const SEEDS = ["Hugo GB", "alice@example.com", "user-42", "team-design", "Chi Nguyen", "ben.okafor"];
---

<div class="gallery not-content">
    <p class="gallery-intro">
        Every style rendered from the same {SEEDS.length} seeds so you can compare them directly.
    </p>

    <div class="gallery-grid">
        {
            STYLES.map(({ name, label, description, style }) => (
                <section class="gallery-style" data-style={name}>
                    <h3>{label}</h3>
                    <code>@avatar-generator/style-{name}</code>
                    <p class="gallery-description">{description}</p>
                    <div class="row">
                        {SEEDS.map((seed) => (
                            <img
                                src={createAvatar(style, { seed, size: 72 }).toDataUri()}
                                width="72"
                                height="72"
                                alt={`${label} avatar for “${seed}”`}
                                title={seed}
                            />
                        ))}
                    </div>
                </section>
            ))
        }
    </div>
</div>

<style>
    .gallery {
        margin: 1.5rem 0;
    }
    .gallery-intro {
        color: var(--sl-color-gray-2);
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }
    .gallery-grid {
        display: grid;
        gap: 1.25rem;
    }
    .gallery-style {
        background: var(--sl-color-gray-7);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
    }
    .gallery-style h3 {
        margin: 0 0 0.15rem 0;
        font-size: 1rem;
    }
    .gallery-style code {
        font-size: 0.72rem;
        color: var(--sl-color-gray-2);
        display: block;
    }
    .gallery-description {
        font-size: 0.85rem;
        color: var(--sl-color-gray-2);
        margin: 0.35rem 0 0.75rem;
    }
    .row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .row img {
        width: 72px;
        height: 72px;
        margin: 0;
    }
</style>
