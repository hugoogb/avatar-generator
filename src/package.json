{
    "name": "avatar-generator",
    "private": true,
    "workspaces": [
        "packages/*",
        "lib/*",
        "lib/styles/*"
    ],
    "scripts": {
        "build": "pnpm -r run build",
        "clean": "rm -rf node_modules && pnpm -r exec rm -rf dist node_modules",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc -p tsconfig.test.json && pnpm -r run typecheck",
        "check:exports": "pnpm -r run publint && pnpm -r run attw",
        "smoke": "node scripts/smoke-test.mjs",
        "verify:publish": "pnpm run build && pnpm run check:exports && pnpm run smoke",
        "changeset": "changeset",
        "version-packages": "changeset version && pnpm install --lockfile-only",
        "check:version": "node scripts/check-release-version.mjs",
        "release:dry": "pnpm run verify:publish && pnpm publish --recursive --access public --no-git-checks --dry-run"
    },
    "devDependencies": {
        "@angular/core": "^19.2.25",
        "@arethetypeswrong/cli": "^0.18.2",
        "@changesets/cli": "^3.0.1",
        "@sveltejs/vite-plugin-svelte": "^3.1.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^22.10.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitest/coverage-v8": "^2.1.9",
        "@vue/test-utils": "^2.5.0",
        "happy-dom": "^20.12.0",
        "publint": "^0.3.14",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "svelte": "^4.2.20",
        "typescript": "^5.7.2",
        "vitest": "^2.1.9",
        "vue": "^3.5.42"
    }
}
