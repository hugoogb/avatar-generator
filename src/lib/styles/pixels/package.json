{
    "name": "@avatar-generator/style-pixels",
    "version": "2.6.1",
    "description": "Pixel art avatar style for @avatar-generator/core",
    "keywords": [
        "avatar",
        "pixel",
        "8bit",
        "retro",
        "svg",
        "generator"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hugoogb/avatar-generator.git",
        "directory": "src/lib/styles/pixels"
    },
    "homepage": "https://github.com/hugoogb/avatar-generator#readme",
    "bugs": {
        "url": "https://github.com/hugoogb/avatar-generator/issues"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2020",
        "typecheck": "tsc -p tsconfig.json",
        "publint": "publint --strict",
        "attw": "attw --pack ."
    },
    "dependencies": {
        "@avatar-generator/core": "workspace:^"
    },
    "devDependencies": {
        "tsup": "^8.5.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
