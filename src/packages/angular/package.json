{
    "name": "@avatar-generator/angular",
    "version": "3.0.0",
    "keywords": [
        "avatar",
        "angular",
        "svg",
        "component"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hugoogb/avatar-generator.git",
        "directory": "src/packages/angular"
    },
    "homepage": "https://github.com/hugoogb/avatar-generator#readme",
    "bugs": {
        "url": "https://github.com/hugoogb/avatar-generator/issues"
    },
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/finalize-package.mjs",
        "typecheck": "tsc -p tsconfig.json",
        "publint": "publint --strict",
        "attw": "node ../../scripts/attw-packed.mjs --ignore-rules cjs-resolves-to-esm"
    },
    "peerDependencies": {
        "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0",
        "@avatar-generator/core": "workspace:^"
    },
    "devDependencies": {
        "@angular/compiler": "^19.2.25",
        "@angular/compiler-cli": "^19.2.25",
        "@angular/core": "^19.0.5",
        "@avatar-generator/core": "workspace:*",
        "ng-packagr": "^19.2.2",
        "tslib": "^2.8.1",
        "typescript": "~5.7.3"
    },
    "publishConfig": {
        "access": "public",
        "directory": "dist"
    },
    "dependencies": {
        "tslib": "^2.3.0"
    }
}
