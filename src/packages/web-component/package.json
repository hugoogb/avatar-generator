{
    "name": "@avatar-generator/web-component",
    "version": "3.1.0",
    "description": "Framework-agnostic <avatar-generator> custom element for deterministic SVG avatars",
    "keywords": [
        "avatar",
        "web-component",
        "custom-element",
        "svg"
    ],
    "license": "MIT",
    "author": {
        "name": "Hugo García Benjumea",
        "url": "https://hugoogb.dev/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hugoogb/avatar-generator.git",
        "directory": "src/packages/web-component"
    },
    "homepage": "https://avatar-generator.hugoogb.dev/",
    "bugs": {
        "url": "https://github.com/hugoogb/avatar-generator/issues"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/avatar-generator.global.js",
    "jsdelivr": "./dist/avatar-generator.global.js",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "sideEffects": true,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2020 && pnpm run build:global",
        "typecheck": "tsc -p tsconfig.json",
        "publint": "publint --strict",
        "attw": "attw --pack .",
        "build:global": "tsup --entry.avatar-generator src/global.ts --format iife --global-name AvatarGenerator --minify --sourcemap --target es2020"
    },
    "peerDependencies": {
        "@avatar-generator/core": "workspace:^"
    },
    "devDependencies": {
        "@avatar-generator/core": "workspace:*",
        "@avatar-generator/style-abstract": "workspace:*",
        "@avatar-generator/style-animals": "workspace:*",
        "@avatar-generator/style-anime": "workspace:*",
        "@avatar-generator/style-emoji": "workspace:*",
        "@avatar-generator/style-faces": "workspace:*",
        "@avatar-generator/style-geometric": "workspace:*",
        "@avatar-generator/style-gradient": "workspace:*",
        "@avatar-generator/style-illustrated": "workspace:*",
        "@avatar-generator/style-initials": "workspace:*",
        "@avatar-generator/style-pixels": "workspace:*",
        "@avatar-generator/style-rings": "workspace:*",
        "tsup": "^8.5.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
