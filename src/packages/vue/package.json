{
    "name": "@avatar-generator/vue",
    "version": "2.5.0",
    "keywords": [
        "avatar",
        "vue",
        "svg",
        "component"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hugoogb/avatar-generator.git",
        "directory": "src/packages/vue"
    },
    "homepage": "https://github.com/hugoogb/avatar-generator#readme",
    "bugs": {
        "url": "https://github.com/hugoogb/avatar-generator/issues"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2020",
        "typecheck": "tsc -p tsconfig.json",
        "publint": "publint --strict",
        "attw": "attw --pack ."
    },
    "peerDependencies": {
        "@avatar-generator/core": "^2.0.0",
        "vue": "^3.0.0"
    },
    "devDependencies": {
        "@avatar-generator/core": "workspace:*",
        "vue": "^3.5.0",
        "tsup": "^8.5.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
