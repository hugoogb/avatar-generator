{
    "name": "create-avatar-style",
    "version": "3.1.0",
    "description": "Scaffold a custom avatar style package for @avatar-generator",
    "keywords": [
        "avatar",
        "svg",
        "generator",
        "scaffold",
        "create"
    ],
    "license": "MIT",
    "author": {
        "name": "Hugo García Benjumea",
        "url": "https://hugoogb.dev/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hugoogb/avatar-generator.git",
        "directory": "src/packages/create-avatar-style"
    },
    "homepage": "https://avatar-generator.hugoogb.dev/guides/custom-styles/",
    "bugs": {
        "url": "https://github.com/hugoogb/avatar-generator/issues"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "create-avatar-style": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target node18 && tsup src/cli.ts --format esm --target node18",
        "typecheck": "tsc -p tsconfig.json",
        "publint": "publint --strict",
        "attw": "attw --pack ."
    },
    "devDependencies": {
        "tsup": "^8.5.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
