{
    "name": "@avatar-generator/svelte",
    "version": "2.5.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "svelte": "./dist/Avatar.svelte",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "svelte": "./dist/Avatar.svelte",
            "default": "./dist/index.js"
        },
        "./Avatar.svelte": "./dist/Avatar.svelte"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsc && cp src/Avatar.svelte dist/Avatar.svelte",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@avatar-generator/core": "^2.0.0",
        "svelte": "^4.0.0 || ^5.0.0"
    },
    "devDependencies": {
        "@avatar-generator/core": "workspace:*",
        "svelte": "^4.2.19"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "avatar",
        "svelte",
        "svg",
        "component"
    ],
    "license": "MIT"
}
