{
    "name": "@avatar-generator/svelte",
    "version": "2.6.1",
    "keywords": [
        "avatar",
        "svelte",
        "svg",
        "component"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hugoogb/avatar-generator.git",
        "directory": "src/packages/svelte"
    },
    "homepage": "https://github.com/hugoogb/avatar-generator#readme",
    "bugs": {
        "url": "https://github.com/hugoogb/avatar-generator/issues"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "svelte": "./dist/Avatar.svelte",
    "exports": {
        ".": {
            "svelte": "./dist/Avatar.svelte",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json",
        "./Avatar.svelte": "./dist/Avatar.svelte"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2020 && node scripts/build-component.mjs",
        "typecheck": "tsc -p tsconfig.json",
        "publint": "publint --strict",
        "attw": "attw --pack . --exclude-entrypoints ./Avatar.svelte"
    },
    "peerDependencies": {
        "@avatar-generator/core": "workspace:^",
        "svelte": "^4.0.0 || ^5.0.0"
    },
    "devDependencies": {
        "@avatar-generator/core": "workspace:*",
        "svelte": "^4.2.19",
        "tsup": "^8.5.0",
        "esbuild": "^0.25.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
